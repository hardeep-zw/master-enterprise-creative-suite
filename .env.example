# =========================================================
# Enterprise Creative Suite - Environment Configuration
# =========================================================

# [REQUIRED] Google Gemini API Key
GEMINI_API_KEY=

# [OPTIONAL] Dedicated Pay-As-You-Go Google Gemini API Key
GEMINI_PAYG_API_KEY=

# [OPTIONAL] Server Port (Defaults to 3000)
PORT=3000
NODE_ENV=development

# [OPTIONAL] Fal.ai API Key for premium visual models
FAL_API_KEY=

# =========================================================
# Razorpay Payment Gateway
# =========================================================
RAZORPAY_MODE=test
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ENABLE_PAYMENT_SIMULATION=false

# [OPTIONAL] ngrok Tunnel Authtoken for Local Webhook Testing
NGROK_AUTHTOKEN=

# =========================================================
# Transactional Email Notification (Resend)
# =========================================================
BILLING_ALERT_EMAIL=writopedia.platform@gmail.com
RESEND_FROM_EMAIL="Writopedia <onboarding@resend.dev>"
RESEND_API_KEY=

# =========================================================
# Supabase Configuration (Modern API Key Architecture)
# =========================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Client-Side Mirrors for Vite SPA
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# =========================================================
# Platform Initial Admin Setup (scripts/setup_admin_user.cjs)
# =========================================================
# SECURITY NOTICE: Never commit real passwords or credentials to version control.
ADMIN_EMAIL=writopedia.platform@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_NAME="Writopedia Platform Admin"

